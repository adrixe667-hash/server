# ===== Core server =====
MC_NAME=mc-survival
MC_TYPE=PAPER
MC_VERSION=LATEST
MC_MEMORY=6G
MC_PORT=25565
MC_ONLINE_MODE=TRUE
MC_ENABLE_WHITELIST=TRUE
TZ=UTC

# ===== Optional tunnel/profile flags =====
ENABLE_PLAYIT=false
ENABLE_CLOUDFLARE_TUNNEL=false

# ===== Grafana =====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ===== Home Assistant =====
ENABLE_MQTT=true
HA_WEBHOOK_URL=https://ha.example.com/api/webhook/mc_event
